<section id="page-header" style="padding-top: 120px; text-align: center;">
   <p class="s-label r">Petualangan</p>
   <h1 class="s-title r">Wahana <em>Seru</em></h1>
   <div class="divider-gold r" style="margin: 1.4rem auto;"></div>
</section>

<section id="wahana" style="padding: 2rem 5% 8rem;">
   <div class="bento">
      <div class="bento-card big r" style="transition-delay:0s">
         <img class="bento-img" src="{{ url(" images/wahana/paintball.jpg") }}" alt="Paintball" />
         <div class="bento-overlay"></div>
         <div class="bento-body">
            <div class="bento-icon">🎯</div>
            <div class="bento-title">Arena Paintball</div>
            <div class="bento-desc">Outdoor 1.500 m², seru untuk team building.</div>
            <span class="bento-tag">Adventure</span>
         </div>
      </div>

      <div class="bento-card r" style="transition-delay:.1s">
         <img class="bento-img" src="{{ url(" images/wahana/kolam-renang.jpg") }}" alt="Kolam Renang" />
         <div class="bento-overlay"></div>
         <div class="bento-body">
            <div class="bento-icon">🏊</div>
            <div class="bento-title">Kolam & Wahana Air</div>
            <div class="bento-desc">Air alami dengan water slide seru.</div>
            <span class="bento-tag">Family</span>
         </div>
      </div>

      <div class="bento-card tall r" style="transition-delay:.2s">
         <img class="bento-img" src="{{ url(" images/wahana/flying-fox.jpg") }}" alt="Outbound" />
         <div class="bento-overlay"></div>
         <div class="bento-body">
            <div class="bento-icon">🧗</div>
            <div class="bento-title">Flying Fox</div>
            <div class="bento-desc">Lintasan 200m yang memacu adrenalin.</div>
            <span class="bento-tag">Adrenaline</span>
         </div>
      </div>

      <div class="bento-card r" style="transition-delay:.3s">
         <img class="bento-img" src="{{ url(" images/wahana/aviary.jpg") }}" alt="Aviary" />
         <div class="bento-overlay"></div>
         <div class="bento-body">
            <div class="bento-icon">🦜</div>
            <div class="bento-title">Aviary</div>
            <div class="bento-desc">Taman burung tropis terbuka.</div>
            <span class="bento-tag">Nature</span>
         </div>
      </div>
   </div>
</section>