<section id="page-header" style="padding-top: 120px; text-align: center;">
    <p class="s-label r">Eksplorasi</p>
    <h1 class="s-title r">Fasilitas <em>Lengkap</em> Kami</h1>
    <div class="divider-gold r" style="margin: 1.4rem auto;"></div>
</section>

<section id="fasilitas" style="padding-top: 2rem;">
    <div class="bento">
        <!-- Fasilitas Cards -->
        <div class="bento-card big r" style="transition-delay:0s">
            <img class="bento-img" src="{{ url("images/slideshow/rusa.jpg") }}" alt="Mini Zoo" />
            <div class="bento-overlay"></div>
            <div class="bento-body">
                <div class="bento-icon">🦁</div>
                <div class="bento-title">Mini Zoo & Satwa Eksotis</div>
                <div class="bento-desc">40+ jenis satwa lokal dan eksotis. Zona petting zoo interaktif yang aman untuk seluruh keluarga.</div>
                <span class="bento-tag">Interaktif • Edukatif</span>
            </div>
        </div>

        <div class="bento-card r" style="transition-delay:.1s">
            <img class="bento-img" src="{{ url("images/fasilitas/fieldtrip.jpg") }}" alt="Field Trip" />
            <div class="bento-overlay"></div>
            <div class="bento-body">
                <div class="bento-icon">🎒</div>
                <div class="bento-title">Program Field Trip</div>
                <div class="bento-desc">Paket TK–SMA dengan pemandu edukatif dan buku aktivitas.</div>
                <span class="bento-tag">Edukasi</span>
            </div>
        </div>

        <div class="bento-card r" style="transition-delay:.2s">
            <div class="bento-card no-img" style="height: 100%; background: linear-gradient(135deg,rgba(30,77,48,.8),rgba(21,46,30,.9));">
                <div class="bento-icon">🕌</div>
                <div class="bento-title">Mushola</div>
                <div class="bento-desc">Fasilitas ibadah yang bersih dan nyaman berkapasitas 60 orang.</div>
                <span class="bento-tag">Religi</span>
            </div>
        </div>

        <div class="bento-card r" style="transition-delay:.3s">
            <div class="bento-card no-img" style="height: 100%; background: linear-gradient(135deg,rgba(107,58,31,.3),rgba(21,46,30,.9));">
                <div class="bento-icon">🚗</div>
                <div class="bento-title">Parkir Luas</div>
                <div class="bento-desc">Area parkir aman untuk 500+ kendaraan dengan pengawasan CCTV.</div>
                <span class="bento-tag">Keamanan</span>
            </div>
        </div>
    </div>
</section>
